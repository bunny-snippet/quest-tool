DEPLOYMENT_ENVIRONMENT=uat
DJANGO_SECRET_KEY=replace-with-a-long-random-uat-secret
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-uat-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=uat.example.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://uat.example.com
DJANGO_BEHIND_HTTPS_PROXY=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=0

DB_ENGINE=mysql
DB_NAME=uat-api-tool
DB_USER=uat-api-tool
DB_PASSWORD=replace-with-uat-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

CELERY_BROKER_URL=redis://127.0.0.1:6379/4
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/5
ENABLE_SCHEDULED_JOBS=false

INNOVATEMR_API_TOKEN=replace-with-uat-innovatemr-token
INNOVATEMR_BASE_URL=https://supplier.innovatemr.net/api/v2
PUBLIC_SUPPLIER_CODE=1000
INNOVATEMR_TIMEOUT_SECONDS=30
INNOVATEMR_PAGE_SIZE=100
INNOVATEMR_MAX_PAGES=1000
INNOVATEMR_DETAIL_REFRESH_BATCH=20
INNOVATEMR_INVENTORY_SYNC_INTERVAL_SECONDS=900
INNOVATEMR_DETAIL_SYNC_INTERVAL_SECONDS=900
INNOVATEMR_ATTEMPT_RECONCILE_INTERVAL_SECONDS=900
INNOVATEMR_ATTEMPT_RECONCILE_BATCH=20
INNOVATEMR_ATTEMPT_RECONCILE_LOOKBACK_HOURS=168
