DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.example,your-vps-ip
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_BEHIND_HTTPS_PROXY=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=0
GUNICORN_BIND=127.0.0.1:8091

DB_ENGINE=mysql
DB_NAME=api-tool
DB_USER=api-tool
DB_PASSWORD=replace-with-hostinger-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

INNOVATEMR_API_TOKEN=replace-with-supplier-api-token
INNOVATEMR_BASE_URL=https://supplier.innovatemr.net/api/v2
PUBLIC_SUPPLIER_CODE=1000
INNOVATEMR_TIMEOUT_SECONDS=30
INNOVATEMR_PAGE_SIZE=100
INNOVATEMR_MAX_PAGES=1000
INNOVATEMR_DETAIL_REFRESH_BATCH=20
INNOVATEMR_INVENTORY_SYNC_INTERVAL_SECONDS=60
CLIENT_INTEGRATION_DISPATCH_INTERVAL_SECONDS=30
CLIENT_INTEGRATION_INNOVATEMR_SYNC_INTERVAL_SECONDS=150
CLIENT_INTEGRATION_RFG_SYNC_INTERVAL_SECONDS=60
INNOVATEMR_DETAIL_SYNC_INTERVAL_SECONDS=60
INNOVATEMR_ATTEMPT_RECONCILE_INTERVAL_SECONDS=60
INNOVATEMR_ATTEMPT_RECONCILE_BATCH=20
INNOVATEMR_ATTEMPT_RECONCILE_LOOKBACK_HOURS=168

# Research For Good Live Alert API (32-character hexadecimal secret).
RFG_APID=
RFG_SECRET=
BIOBRAIN_API_KEY=
VENDOR_RESERVATION_TTL_MINUTES=180
VENDOR_RESERVATION_CLEANUP_INTERVAL_SECONDS=60
TRUST_X_FORWARDED_FOR=true

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
