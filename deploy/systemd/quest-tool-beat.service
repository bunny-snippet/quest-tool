[Unit]
Description=Quest Tool Celery periodic scheduler
After=network.target redis-server.service mysql.service
Requires=redis-server.service

[Service]
Type=simple
User=questtool
Group=questtool
WorkingDirectory=/opt/quest-tool
EnvironmentFile=/etc/quest-tool/quest-tool.env
Environment=PYTHONUNBUFFERED=1
StateDirectory=quest-tool
ExecStart=/opt/quest-tool/.venv/bin/celery -A config beat --loglevel=INFO --schedule=/var/lib/quest-tool/celerybeat-schedule
Restart=always
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target

