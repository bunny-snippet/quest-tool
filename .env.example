DJANGO_SECRET_KEY=replace-me-in-production
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
# Stable encryption key for real respondent emails in the dedicated vault DB.
# Never rotate this value without first re-encrypting the stored pool.
RESPONDENT_EMAIL_ENCRYPTION_KEY=replace-with-another-long-random-secret
CINT_EMAIL_IDENTITY_CACHE_TTL_SECONDS=3600
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_BEHIND_HTTPS_PROXY=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0

# API documentation has two gates: an admin/super-admin Django session and
# these separate HTTP Basic credentials. Always use a long production password.
API_DOCS_BASIC_USERNAME=api-tool
API_DOCS_BASIC_PASSWORD=

# Database. Keep DB_ENGINE=sqlite for local development. Use mysql on the VPS.
DB_ENGINE=sqlite
DB_NAME=api-tool
DB_USER=api-tool
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# Dedicated prescreener response vault. In production this must point to a
# different MySQL database/user than the operational DB above.
PRESCREENER_VAULT_ENABLED=false
PRESCREENER_DB_ENGINE=sqlite
PRESCREENER_DB_NAME=prescreener-vault
PRESCREENER_DB_USER=
PRESCREENER_DB_PASSWORD=
PRESCREENER_DB_HOST=127.0.0.1
PRESCREENER_DB_PORT=3306
PRESCREENER_DB_CONN_MAX_AGE=60
PRESCREENER_DB_CONNECT_TIMEOUT=10

# InnovateMR Supplier API. Never expose this value to browser code or commit it.
INNOVATEMR_API_TOKEN=
INNOVATEMR_BASE_URL=https://supplier.innovatemr.net/api/v2
PUBLIC_SUPPLIER_CODE=1000
INNOVATEMR_TIMEOUT_SECONDS=30
INNOVATEMR_PAGE_SIZE=100
INNOVATEMR_MAX_PAGES=1000
INNOVATEMR_DETAIL_REFRESH_BATCH=20
INNOVATEMR_INVENTORY_SYNC_INTERVAL_SECONDS=60
CLIENT_INTEGRATION_DISPATCH_INTERVAL_SECONDS=30
CLIENT_INTEGRATION_INNOVATEMR_SYNC_INTERVAL_SECONDS=150
CLIENT_INTEGRATION_RFG_SYNC_INTERVAL_SECONDS=60
CLIENT_INTEGRATION_CINT_SYNC_INTERVAL_SECONDS=60
INNOVATEMR_DETAIL_SYNC_INTERVAL_SECONDS=60
INNOVATEMR_ATTEMPT_RECONCILE_INTERVAL_SECONDS=60
INNOVATEMR_ATTEMPT_RECONCILE_BATCH=20
INNOVATEMR_ATTEMPT_RECONCILE_LOOKBACK_HOURS=168

# Research For Good Live Alert. The Client Catalog stores only these variable names.
RFG_APID=
RFG_SECRET=
CINT_API_KEY=
CINT_HASH_KEY=
PUBLIC_APP_BASE_URL=http://127.0.0.1:8000
CINT_CALLBACK_BASE_URL=
CINT_OPPORTUNITIES_WEBHOOK_ENABLED=false
CINT_OPPORTUNITIES_SUPPLIER_CODE=
CINT_OPPORTUNITIES_PUBLIC_KEY=
CINT_OPPORTUNITIES_KEY_ID=
CINT_OPPORTUNITIES_LOCAL_TEST_TOKEN=
CINT_OPPORTUNITIES_SIGNATURE_TOLERANCE_SECONDS=300
CINT_OPPORTUNITIES_MAX_PAYLOAD_BYTES=10485760
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=10551296
CINT_OPPORTUNITIES_MAX_SURVEY_COUNT=1000
CINT_OPPORTUNITIES_PROCESS_SYNCHRONOUS=false
CINT_OPPORTUNITIES_QUEUE_REDIRECTS=true
# Cint delivery bodies are immutable source records and are always retained.
# This compatibility setting is intentionally forced true by the application.
CINT_OPPORTUNITIES_RETAIN_PROCESSED_PAYLOADS=true
CINT_PROJECT_CACHE_INVALIDATION_SECONDS=30
VENDOR_RESERVATION_TTL_MINUTES=180
VENDOR_RESERVATION_CLEANUP_INTERVAL_SECONDS=60

# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false
ENFORCE_SURVEY_TARGET_COUNTRY=true
# Preferred at scale: point this at a GeoLite2/GeoIP2 City .mmdb file.
GEOIP_CITY_DB_PATH=
# Optional fallback. Leave blank when every web node has the local City DB.
GEOIP_LOOKUP_URL=
GEOIP_LOOKUP_TIMEOUT_SECONDS=2.5
GEOIP_CACHE_TTL_SECONDS=2592000

# Redis cache uses a dedicated logical DB. MySQL remains authoritative; cache
# failures fall back to the database. TTL jitter prevents mass simultaneous expiry.
CACHE_ENABLED=false
REDIS_CACHE_URL=redis://127.0.0.1:6379/2
CACHE_KEY_PREFIX=quest-tool
CACHE_DEFAULT_TTL_SECONDS=900
CACHE_TTL_JITTER_SECONDS=180
CACHE_CONNECT_TIMEOUT_SECONDS=1
CACHE_SOCKET_TIMEOUT_SECONDS=1
CACHE_MAX_CONNECTIONS=100
VAULT_CACHE_OPTIONS_TTL_SECONDS=600
VAULT_CACHE_SUMMARY_TTL_SECONDS=180
VAULT_CACHE_PROFILE_TTL_SECONDS=900
PROJECTS_REDIS_CACHE_URL=redis://127.0.0.1:6379/3
PROJECT_CACHE_DEFAULT_TTL_SECONDS=300
PROJECT_CACHE_TTL_JITTER_SECONDS=60
PROJECT_CACHE_FILTERS_TTL_SECONDS=600
PROJECT_CACHE_COUNT_TTL_SECONDS=90

# Celery uses separate Redis logical databases.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
BIOBRAIN_API_KEY=
