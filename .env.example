DJANGO_SECRET_KEY=replace-me-in-production
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_BEHIND_HTTPS_PROXY=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0

# Database. Keep DB_ENGINE=sqlite for local development. Use mysql on the VPS.
DB_ENGINE=sqlite
DB_NAME=api-tool
DB_USER=api-tool
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# InnovateMR Supplier API. Never expose this value to browser code or commit it.
INNOVATEMR_API_TOKEN=
INNOVATEMR_BASE_URL=https://supplier.innovatemr.net/api/v2
PUBLIC_SUPPLIER_CODE=1000
INNOVATEMR_TIMEOUT_SECONDS=30
INNOVATEMR_PAGE_SIZE=100
INNOVATEMR_MAX_PAGES=1000
INNOVATEMR_DETAIL_REFRESH_BATCH=20
INNOVATEMR_INVENTORY_SYNC_INTERVAL_SECONDS=60
CLIENT_INTEGRATION_DISPATCH_INTERVAL_SECONDS=30
CLIENT_INTEGRATION_INNOVATEMR_SYNC_INTERVAL_SECONDS=150
CLIENT_INTEGRATION_RFG_SYNC_INTERVAL_SECONDS=60
INNOVATEMR_DETAIL_SYNC_INTERVAL_SECONDS=60
INNOVATEMR_ATTEMPT_RECONCILE_INTERVAL_SECONDS=60
INNOVATEMR_ATTEMPT_RECONCILE_BATCH=20
INNOVATEMR_ATTEMPT_RECONCILE_LOOKBACK_HOURS=168

# Research For Good Live Alert. The Client Catalog stores only these variable names.
RFG_APID=
RFG_SECRET=
VENDOR_RESERVATION_TTL_MINUTES=180
VENDOR_RESERVATION_CLEANUP_INTERVAL_SECONDS=60

# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false

# Celery (Redis shown; replace with production broker URLs).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
BIOBRAIN_API_KEY=
